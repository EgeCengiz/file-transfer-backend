PORT=3000
# Virgulle birden fazla origin; protokol zorunlu (https:// veya http://)
CORS_ORIGIN=https://file.optimalajans.com,http://file.optimalajans.com,http://localhost:5173

# MySQL baglantisi
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=file_transfer

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# Depolama
# Windows icin ornek: C:/file-transfer-storage
UPLOAD_DIR=./storage
# 100GB = 107374182400 byte
QUOTA_BYTES=107374182400

# Uygulamaya girmek icin kullanilacak tek ortak sifre (kullanici adi yok)
APP_PASSWORD=change-this-password
